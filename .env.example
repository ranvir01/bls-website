# Copy to .env.local for development. In production these live in
# Netlify → Site configuration → Environment variables.
#
# Every block below degrades gracefully when unset — see docs/DEPLOYMENT.md for
# exactly what happens in each case. Nothing here has a working default.

# ── Lead delivery (highest priority) ─────────────────────────────────────────
# Without these, form submissions are validated and logged but nobody is
# notified. Do not run production this way.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
# Gmail requires an App Password here, not the account password.
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Formspree is the delivery floor: it fires on every submission regardless of
# whether SMTP above is configured, so a lead still reaches someone while the
# mail settings are empty. It has a working default baked into data/business.ts
# and only needs setting here to point at a different form.
FORMSPREE_ENDPOINT=

# ── SMS speed-to-lead ────────────────────────────────────────────────────────
# When absent, SMS is skipped and email still goes out.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +12065550100
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# ── Analytics ────────────────────────────────────────────────────────────────
# When unset, no analytics script loads at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Yard visualizer ──────────────────────────────────────────────────────────
# When unset the visualizer runs in degraded mode: it still builds the scope,
# the cost range and the lead — it just does not render an image, and says so.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=

# ── Lightweight CRM (optional) ───────────────────────────────────────────────
# Every lead is POSTed here as JSON. Google Apps Script, Zapier or Airtable.
LEAD_WEBHOOK_URL=
