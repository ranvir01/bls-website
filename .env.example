# Copy to .env.local for development. In production these live in
# Netlify → Site configuration → Environment variables.
#
# Every block below degrades gracefully when unset — see docs/DEPLOYMENT.md for
# exactly what happens in each case. Nothing here has a working default.

# ── Lead delivery (highest priority) ─────────────────────────────────────────
# Without these, form submissions are validated and logged but nobody is
# notified. Do not run production this way.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
# Gmail requires an App Password here, not the account password.
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ── SMS speed-to-lead ────────────────────────────────────────────────────────
# When absent, SMS is skipped and email still goes out.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +12065550100
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# ── Analytics ────────────────────────────────────────────────────────────────
# When unset, no analytics script loads at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Yard visualizer ──────────────────────────────────────────────────────────
# One Google AI Studio key is enough for photoreal after-photos of the
# uploaded yard (Gemini 2.5 Flash Image / Nano Banana). Without a key the
# tool still returns a written scope, a cost range, and real comparable jobs.
#
# Almost-free path:
#   IMAGE_API_KEY=<Google AI Studio key>
# Optional:
#   IMAGE_API_MODEL=gemini-2.5-flash-image
#   IMAGE_PROVIDER=gemini
#
# Other providers:
#   IMAGE_PROVIDER=generic
#   IMAGE_API_URL=https://...
#   IMAGE_API_KEY=...
#   IMAGE_API_MODEL=
IMAGE_API_KEY=
IMAGE_API_URL=
IMAGE_API_MODEL=
IMAGE_PROVIDER=

# ── Lightweight CRM (optional) ───────────────────────────────────────────────
# Every lead is POSTed here as JSON. Google Apps Script, Zapier or Airtable.
LEAD_WEBHOOK_URL=
